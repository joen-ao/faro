NEXT_PUBLIC_PRODUCT_NAME=Faro
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=                     # vacío = PGlite local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MODE=mock
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_MODE=real
SOCRATA_APP_TOKEN=                 # opcional
SOCRATA_RUES_DATASET=c82u-588k
SOCRATA_REPS_DATASET=c36g-9fc2
SOCRATA_MODE=real
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_MODE=mock
APIFY_TOKEN=
APIFY_CONTACT_ACTOR_ID=            # verificar el sábado (Contact Details Scraper)
APIFY_MODE=mock
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=             # whsec_... del webhook de Resend -> /api/webhooks/email (sin él responde 401)
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_MODE=mock
SEND_ENABLED=false
SEND_WINDOW_POLICY=ley2300          # ley2300 (L–V 7–19, sáb 8–15, nunca domingo/festivo) | extendida (todos los días 8–20)
OPTOUT_SECRET=
DAPTA_MODE=widget_only             # widget_only | http_push | csv_export
NEXT_PUBLIC_WHATSAPP_NUMBER=573014734934  # CTA "Hablar por WhatsApp" de /d/[slug] (solo dígitos, con indicativo)
DAPTA_PUSH_URL=                    # si el entorno de prueba lo da
DAPTA_PUSH_API_KEY=
DAPTA_WEBHOOK_SECRET=
DAPTA_CREDIT_USD=0.001
DAPTA_CREDITS_PER_AI_REPLY=40
WHATSAPP_ENABLED=false             # WhatsApp opcional via Dapta (export CSV + webhook); Faro no envia nada
WHATSAPP_WEBHOOK_SECRET=           # secreto compartido de POST /api/webhooks/whatsapp (x-whatsapp-secret o Bearer)
META_ADS_CAMPAIGN_ID=
# F28 · Meta Marketing API (token de usuario del sistema; secreto). real solo con token + cuenta + página
META_ADS_MODE=mock
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=                # act_...
META_PAGE_ID=
META_API_VERSION=v25.0
META_COP_PER_USD=4000              # tasa para guardar el gasto COP como USD en ad_spend
META_ADS_ALLOWED_DOMAINS=mokub.co,www.mokub.co,web.mokub.co   # destinos permitidos de los anuncios (+ el host de la app)
META_PIXEL_ID=                     # F31: conjunto de datos "Mokub"; vacío = sin píxel ni API de Conversiones
META_CAPI_TEST_CODE=               # F31: código de prueba de Events Manager (solo para probar; vacío en prod)
ADS_SPEND_ENABLED=false            # activar campañas (gastar dinero) solo con true + confirmación por nombre
ADS_MAX_DAILY_BUDGET_COP=50000     # tope de presupuesto diario por campaña
NEXT_PUBLIC_MAP_STYLE_URL=
SENDER_LEGAL_NAME=
SENDER_ADDRESS=
HUMAN_MINUTE_RATE_USD=0.42
# F30 · Login con correo y contraseña: las cuentas viven en la tabla `users` (crea la tuya con `npm run auth:set-password`).
AUTH_SECRET=                       # opcional, >= 32 caracteres; firma las sesiones (si falta, se deriva de APP_ACCESS_KEY)
APP_ACCESS_KEY=                    # clave simple para /app y APIs internas (header x-app-key o cookie faro_key); vacío = abierto solo fuera de producción

# Búsqueda gratis de sitios web y redes (F22). Una de las dos; sin ninguna, Faro solo adivina el dominio.
# Brave Search API, plan gratis: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# Google Programmable Search (100 consultas/día gratis): API key + ID del buscador (cx)
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
# Tope de consultas de búsqueda web por mes (Brave da ~1.000 gratis; por encima cobra la tarjeta)
WEB_SEARCH_MONTHLY_LIMIT=900
# F24 · WhatsApp por Dapta: off | dapta_flow. La URL del webhook del flujo lleva su llave (secreta).
WHATSAPP_SEND_MODE=off
DAPTA_WA_FLOW_URL=
# Ids de Dapta de las plantillas nuevas (vacío = no se ofrecen)
DAPTA_WA_TEMPLATE_CLINICA=  # F37: id de mokub_diagnostico_clinica cuando Meta la apruebe (si no, se usa la de Faro)
DAPTA_WA_TEMPLATE_EMPRESA=
DAPTA_WA_TEMPLATE_INDEPENDIENTE=
WHATSAPP_DAILY_LIMIT=50
# F25 · Vercel Cron envía Authorization: Bearer $CRON_SECRET
CRON_SECRET=
# F27 · Respuestas: subdominio de recepción en Resend (solo tras verificar su MX), buzón del equipo y clave con acceso completo
EMAIL_REPLY_DOMAIN=
REPLY_FORWARD_TO=
RESEND_INBOUND_API_KEY=
